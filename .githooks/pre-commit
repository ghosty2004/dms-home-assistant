#!/bin/sh
# Blocks commits that contain something looking like a Home Assistant access token.
# Enable once per clone: git config core.hooksPath .githooks

pattern='eyJ[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}\.[A-Za-z0-9_-]{20,}|"(hassToken|access_token)"[[:space:]]*:[[:space:]]*"[^"]{20,}"'

if git diff --cached -U0 --no-color | grep '^+' | grep -Eq "$pattern"; then
    echo "pre-commit: a staged change looks like an access token. Commit aborted." >&2
    echo "Remove it, or use 'git commit --no-verify' if this is a false positive." >&2
    exit 1
fi
